# Kopie nach .env anlegen und Werte ausfüllen für echten SMTP-Versand.
# Backend lädt .env automatisch beim Start (python-dotenv).

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# Für Port 587 in der Regel true; bei reinem SMTP_SSL (Port 465) ggf. anpassen
SMTP_USE_TLS=true

# --- DEV CORS / Handy-WLAN ---
# Standard 1 oder leer = LAN-IPs (privates IPv4) auf Frontend-Port 51710 zusätzlich erlaubt.
# Auf 0 setzen = nur noch http://localhost:51710 und http://127.0.0.1:51710

# --- Optionale OpenAI-Strukturierung (KI für /api/structure-report) ---
# 1. Diese Datei nach "backend/.env" kopieren (falls .env noch nicht existiert).
# 2. Nur in "backend/.env" arbeiten — dort bei der Zeile OPENAI_API_KEY= direkt NACH
#    dem Gleichheitszeichen deinen Key einfügen (ohne Anführungszeichen, eine Zeile).
# 3. NIEMALS einen echten Key in .env.example speichern oder committen.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

